@inherits PsComponentBase

<MudNavMenu UserAttributes="UserAttributes"
            Style="@StyleName"
            Class="@ClassName">
    <MudNavLink Href="@PsNavigationManager.MainRoutes.Home"
                Match="NavLinkMatch.All">
        Home
    </MudNavLink>
    <MudNavGroup Title="Components" Expanded="true">
        <MudNavLink Href="@PsNavigationManager.ComponentsRoutes.ContextMenu"
                    Match="NavLinkMatch.Prefix">
            Context Menu
        </MudNavLink>
    </MudNavGroup>
    <MudNavGroup Title="Features" Expanded="true">
        <MudNavLink Href="@PsNavigationManager.FeaturesRoutes.RenderTracer"
                    Match="NavLinkMatch.Prefix">
            Render Tracer
        </MudNavLink>
    </MudNavGroup>
</MudNavMenu>