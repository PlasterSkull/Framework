@inherits PsComponentBase

<div @attributes="UserAttributes"
     style="@StyleName"
     class="@ClassName d-flex flex-column align-center justify-center gap-2 pa-4">
    <MudStack Row="true" AlignItems="AlignItems.Center">
        <MudText>
            Level 1
        </MudText>

        <MudButton Variant="Variant.Outlined"
                   Size="Size.Small"
                   OnClick="OnOwnButtonClick">
            Click!
        </MudButton>
    </MudStack>

    <MudText Typo="Typo.caption">
        Subscribed only left component
    </MudText>

    <NestingLevelTwoBlockExample RaiseChildrenEvent="true"
                                 OnClick="OnChildrenComponentButtonClick" />
    <NestingLevelTwoBlockExample />
</div>

@code {

    protected override void OnInitialized()
    {
        EnableRenderTracing();

        base.OnInitialized();
    }

    private void OnOwnButtonClick()
    {

    }

    private void OnChildrenComponentButtonClick()
    {

    }
}
